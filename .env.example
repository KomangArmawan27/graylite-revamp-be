ENV=dev

# database
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_WRITE_USER=
DB_WRITE_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERT=yes
DB_CONNECT_TIMEOUT_SECONDS=15
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# limits and switches
QUERY_TIMEOUT_SEC=30
ROW_CAP=1000
CONFIG_CACHE_TTL_SEC=60
ENABLE_WRITES=false
ENABLE_DELETE=false
EDIT_LOCK_FIELD=docflow_seq
EDIT_LOCK_VALUE=0

# auth
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=
